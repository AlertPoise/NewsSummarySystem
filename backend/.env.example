# A-阶段1：由 A 在本机环境复制为 .env 后填写数据库密码；输入为本机 MySQL 应用账户密码，输出为仅本机使用的环境变量，必须遵守 docs/DATABASE.md。
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=news_summary
DB_USER=news_app
DB_PASSWORD=CHANGE_ME
DB_CHARSET=utf8mb4

# 中文 BERT checkpoint（C2-03 已定）：C 正式选型，句向量编码用
BERT_MODEL_NAME=google-bert/bert-base-chinese
# TODO(B-阶段2)：由 B 根据 CNewSum 正式微调结果填写；输入为验收后的正式摘要模型信息，输出为唯一模型标识，必须遵守 docs/ARCHITECTURE.md 第 4 节（B→C 模型交付）。
SUMMARIZER_MODEL_NAME=CHANGE_ME

MODEL_DIR=../runtime/models
DATASET_DIR=../runtime/datasets
HF_HOME=../runtime/hf_cache
LOG_DIR=../runtime/logs

# TODO(B-阶段2)：由 B 在模型评价通过后填写版本；输入为正式模型版本规则，输出为 model_evaluations 和 SummaryResult 共用的版本值，必须遵守 docs/DATABASE.md。
MODEL_VERSION=CHANGE_ME
# TODO(C-阶段2)：由 C 按正式 tokenizer 实测填写；输入为摘要模型最大输入能力，输出为正整数 Token Budget，必须遵守 SummaryPipeline.generate(article) 的冻结接口。
SUMMARIZER_MAX_INPUT_TOKENS=CHANGE_ME
# TODO(B-阶段2)：由 B 按 CNewSum 验证结果填写；输入为生成长度评价结果，输出为正整数生成 Token 上限，必须遵守 model_training/config.yaml。
SUMMARIZER_MAX_NEW_TOKENS=CHANGE_ME
